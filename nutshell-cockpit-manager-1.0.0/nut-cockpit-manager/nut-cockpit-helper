#!/usr/bin/env python3
"""Privileged backend for the Cockpit NUT Manager extension.

This helper intentionally accepts only a fixed set of operations and validates
all user-provided values before touching Network UPS Tools configuration.
"""

from __future__ import annotations

import argparse
import datetime as dt
import grp
import ipaddress
import json
import os
import re
import secrets
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any

APP_NAME = "Cockpit NUT Manager"
APP_VERSION = "1.0.0"
CONF_DIR = Path(os.environ.get("NUT_WEB_CONF_DIR", "/etc/nut"))
BACKUP_ROOT = Path(os.environ.get("NUT_WEB_BACKUP_ROOT", "/var/backups/nut-manager"))
NUT_PORT = 3493
DRY_RUN = os.environ.get("NUT_WEB_DRY_RUN", "0") == "1"
ALLOWED_CONFIGS = {
    "nut.conf",
    "ups.conf",
    "upsd.conf",
    "upsd.users",
    "upsmon.conf",
    "upssched.conf",
}
IDENTIFIER_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
HOST_RE = re.compile(r"^[A-Za-z0-9._:\-\[\]]+$")


class AppError(RuntimeError):
    pass


def emit(data: Any, *, ok: bool = True) -> None:
    payload = data if isinstance(data, dict) else {"result": data}
    payload.setdefault("ok", ok)
    print(json.dumps(payload, ensure_ascii=False))


def fail(message: str, *, details: str | None = None, status: int = 1) -> None:
    payload: dict[str, Any] = {"ok": False, "error": message}
    if details:
        payload["details"] = details
    print(json.dumps(payload, ensure_ascii=False))
    raise SystemExit(status)


def require_root() -> None:
    if os.geteuid() != 0:
        raise AppError("This operation requires administrator privileges in Cockpit.")


def read_payload() -> dict[str, Any]:
    raw = sys.stdin.read()
    if not raw.strip():
        return {}
    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise AppError(f"Invalid request data: {exc}") from exc
    if not isinstance(parsed, dict):
        raise AppError("Request data must be a JSON object.")
    return parsed


def run(
    command: list[str],
    *,
    timeout: int = 60,
    check: bool = False,
    input_text: str | None = None,
) -> subprocess.CompletedProcess[str]:
    try:
        completed = subprocess.run(
            command,
            input=input_text,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
            check=False,
            env={**os.environ, "LC_ALL": "C"},
        )
    except FileNotFoundError as exc:
        raise AppError(f"Required command is not installed: {command[0]}") from exc
    except subprocess.TimeoutExpired as exc:
        raise AppError(f"Command timed out: {' '.join(command)}") from exc
    if check and completed.returncode != 0:
        raise AppError(
            f"Command failed ({completed.returncode}): {' '.join(command)}\n"
            f"{completed.stdout.strip()}"
        )
    return completed


def command_exists(name: str) -> bool:
    return shutil.which(name) is not None


def nut_group() -> str:
    try:
        grp.getgrnam("nut")
        return "nut"
    except KeyError:
        return "root"


def ensure_dirs() -> None:
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    BACKUP_ROOT.mkdir(parents=True, exist_ok=True)
    os.chmod(CONF_DIR, 0o750)
    os.chmod(BACKUP_ROOT, 0o700)


def secure_permissions() -> None:
    ensure_dirs()
    group = nut_group()
    gid = grp.getgrnam(group).gr_gid
    os.chown(CONF_DIR, 0, gid)
    os.chmod(CONF_DIR, 0o750)
    for name in ALLOWED_CONFIGS:
        path = CONF_DIR / name
        if path.exists():
            os.chown(path, 0, gid)
            os.chmod(path, 0o640)


def backup_configs() -> str:
    ensure_dirs()
    base = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    target = BACKUP_ROOT / base
    suffix = 0
    while target.exists():
        suffix += 1
        target = BACKUP_ROOT / f"{base}-{suffix}"
    target.mkdir(mode=0o700)
    if CONF_DIR.exists():
        for item in CONF_DIR.iterdir():
            destination = target / item.name
            if item.is_dir():
                shutil.copytree(item, destination, symlinks=True)
            else:
                shutil.copy2(item, destination, follow_symlinks=False)
    return str(target)


def atomic_write(path: Path, content: str, mode: int = 0o640) -> None:
    ensure_dirs()
    group = nut_group()
    gid = grp.getgrnam(group).gr_gid
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(content.rstrip("\n") + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chown(temp_name, 0, gid)
        os.chmod(temp_name, mode)
        os.replace(temp_name, path)
    finally:
        if os.path.exists(temp_name):
            os.unlink(temp_name)


def parse_mode() -> str:
    path = CONF_DIR / "nut.conf"
    if not path.exists():
        return "not configured"
    for raw_line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw_line.strip()
        if line.startswith("MODE="):
            return line.split("=", 1)[1].strip()
    return "not configured"


def configured_ups_names() -> list[str]:
    path = CONF_DIR / "ups.conf"
    if not path.exists():
        return []
    names: list[str] = []
    for raw_line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw_line.strip()
        if line.startswith("[") and line.endswith("]"):
            name = line[1:-1].strip()
            if name:
                names.append(name)
    return names


def default_ups_target() -> str:
    path = CONF_DIR / "upsmon.conf"
    if path.exists():
        for raw_line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            parts = raw_line.split()
            if len(parts) >= 2 and parts[0] == "MONITOR":
                return parts[1]
    names = configured_ups_names()
    return f"{names[0]}@localhost" if names else "ups@localhost"


def validate_identifier(value: Any, label: str) -> str:
    text = str(value or "").strip()
    if not IDENTIFIER_RE.fullmatch(text):
        raise AppError(f"{label} contains unsupported characters.")
    if text == "default":
        raise AppError(f"{label} cannot be 'default'.")
    return text


def validate_host(value: Any, label: str = "Host") -> str:
    text = str(value or "").strip()
    if not text or not HOST_RE.fullmatch(text):
        raise AppError(f"{label} is invalid.")
    return text


def validate_ipv4(value: Any) -> str:
    text = str(value or "").strip()
    try:
        parsed = ipaddress.ip_address(text)
    except ValueError as exc:
        raise AppError("Listen address must be a valid IPv4 address.") from exc
    if parsed.version != 4:
        raise AppError("Listen address must be IPv4.")
    return text


def validate_password(value: Any, *, allow_generate: bool = False) -> tuple[str, bool]:
    text = str(value or "")
    generated = False
    if not text and allow_generate:
        text = secrets.token_urlsafe(18).replace("-", "A").replace("_", "b")[:24]
        generated = True
    if not text:
        raise AppError("A password is required.")
    if any(char.isspace() for char in text) or "#" in text:
        raise AppError("Passwords cannot contain whitespace or #.")
    return text, generated


def validate_port(value: Any) -> str:
    text = str(value or "").strip()
    if not text or any(char.isspace() for char in text) or "#" in text:
        raise AppError("UPS port cannot be empty or contain whitespace or #.")
    if len(text) > 512:
        raise AppError("UPS port value is too long.")
    return text


def quoted(value: Any) -> str:
    return str(value or "").replace("\\", "\\\\").replace('"', '\\"')


def primary_lan_ipv4() -> str:
    result = run(["ip", "-4", "route", "get", "1.1.1.1"], timeout=5)
    parts = result.stdout.split()
    if "src" in parts:
        index = parts.index("src")
        if index + 1 < len(parts):
            return parts[index + 1]
    result = run(["hostname", "-I"], timeout=5)
    addresses = result.stdout.split()
    return addresses[0] if addresses else "127.0.0.1"


def service_state(service: str) -> dict[str, str]:
    active = run(["systemctl", "is-active", service], timeout=10).stdout.strip() or "unknown"
    enabled = run(["systemctl", "is-enabled", service], timeout=10).stdout.strip() or "unknown"
    return {"active": active, "enabled": enabled}


def apply_configuration() -> str:
    if DRY_RUN:
        return "Dry-run mode: service changes skipped."
    lines: list[str] = []
    run(["systemctl", "daemon-reload"], timeout=20)

    if command_exists("upsdrvsvcctl"):
        result = run(["upsdrvsvcctl", "resync"], timeout=45)
        lines.append(f"upsdrvsvcctl resync: {result.returncode}")

    enumerator = run(
        ["systemctl", "list-unit-files", "nut-driver-enumerator.service", "--no-legend"],
        timeout=15,
    )
    if "nut-driver-enumerator.service" in enumerator.stdout:
        result = run(["systemctl", "restart", "nut-driver-enumerator.service"], timeout=45)
        lines.append(f"driver enumerator restart: {result.returncode}")

    mode = parse_mode()
    if mode in {"standalone", "netserver"}:
        run(["systemctl", "enable", "nut-server.service", "nut-monitor.service"], timeout=30)
        server = run(["systemctl", "restart", "nut-server.service"], timeout=45)
        monitor = run(["systemctl", "restart", "nut-monitor.service"], timeout=45)
        lines.extend(
            [
                f"nut-server restart: {server.returncode}",
                f"nut-monitor restart: {monitor.returncode}",
            ]
        )
    elif mode == "netclient":
        if command_exists("upsdrvsvcctl"):
            run(["upsdrvsvcctl", "stop"], timeout=45)
        run(["systemctl", "stop", "nut-driver.target"], timeout=30)
        run(["systemctl", "disable", "--now", "nut-server.service"], timeout=30)
        run(["systemctl", "enable", "nut-monitor.service"], timeout=30)
        monitor = run(["systemctl", "restart", "nut-monitor.service"], timeout=45)
        lines.append(f"nut-monitor restart: {monitor.returncode}")
    return "\n".join(lines) or "Configuration saved; no service action was required."


def op_summary(_: dict[str, Any]) -> dict[str, Any]:
    services = {}
    for service in ["nut-server.service", "nut-monitor.service", "nut-driver.target"]:
        try:
            services[service] = service_state(service)
        except AppError as exc:
            services[service] = {"active": "unknown", "enabled": "unknown", "error": str(exc)}

    target = default_ups_target()
    status_text = ""
    status: dict[str, str] = {}
    if command_exists("upsc"):
        result = run(["upsc", target], timeout=12)
        status_text = result.stdout.strip()
        if result.returncode == 0:
            for line in status_text.splitlines():
                if ": " in line:
                    key, value = line.split(": ", 1)
                    status[key] = value

    return {
        "version": APP_VERSION,
        "hostname": run(["hostname"], timeout=5).stdout.strip(),
        "mode": parse_mode(),
        "lan_ip": primary_lan_ipv4(),
        "ups_names": configured_ups_names(),
        "default_target": target,
        "services": services,
        "ups_status": status,
        "ups_status_text": status_text,
    }


def op_server_setup(data: dict[str, Any]) -> dict[str, Any]:
    require_root()
    mode = str(data.get("mode", "standalone"))
    if mode not in {"standalone", "netserver"}:
        raise AppError("Server mode must be standalone or netserver.")
    ups_name = validate_identifier(data.get("ups_name"), "UPS name")
    driver = validate_identifier(data.get("driver"), "Driver")
    port = validate_port(data.get("port", "auto"))
    description = quoted(data.get("description", f"UPS connected to {os.uname().nodename}"))
    listen_ip = "127.0.0.1" if mode == "standalone" else validate_ipv4(data.get("listen_ip"))
    primary_user = validate_identifier(data.get("primary_user"), "Primary username")
    primary_password, generated_primary = validate_password(
        data.get("primary_password"), allow_generate=True
    )
    client_user = ""
    client_password = ""
    generated_client = False
    if mode == "netserver":
        client_user = validate_identifier(data.get("client_user"), "Client username")
        if client_user == primary_user:
            raise AppError("Primary and client usernames must be different.")
        client_password, generated_client = validate_password(
            data.get("client_password"), allow_generate=True
        )

    backup = backup_configs()
    set_mode = (
        f"# Managed by {APP_NAME} {APP_VERSION}\n"
        "# Valid modes: none, standalone, netserver, netclient\n"
        f"MODE={mode}"
    )
    ups_conf = (
        f"# Managed by {APP_NAME} {APP_VERSION}\n"
        f"[{ups_name}]\n"
        f"    driver = {driver}\n"
        f"    port = {port}\n"
        f"    desc = \"{description}\""
    )
    listeners = f"LISTEN 127.0.0.1 {NUT_PORT}"
    if mode == "netserver" and listen_ip != "127.0.0.1":
        listeners += f"\nLISTEN {listen_ip} {NUT_PORT}"
    upsd_conf = (
        f"# Managed by {APP_NAME} {APP_VERSION}\n"
        "MAXAGE 15\n"
        f"{listeners}"
    )
    users_conf = (
        f"# Managed by {APP_NAME} {APP_VERSION}\n"
        f"[{primary_user}]\n"
        f"    password = {primary_password}\n"
        "    upsmon primary"
    )
    if mode == "netserver":
        users_conf += (
            f"\n\n[{client_user}]\n"
            f"    password = {client_password}\n"
            "    upsmon secondary"
        )
    upsmon_conf = (
        f"# Managed by {APP_NAME} {APP_VERSION}\n"
        f"MONITOR {ups_name}@localhost 1 {primary_user} {primary_password} primary\n"
        "MINSUPPLIES 1\n"
        'SHUTDOWNCMD "/sbin/shutdown -h +0"\n'
        "POLLFREQ 5\n"
        "POLLFREQALERT 5\n"
        "HOSTSYNC 15\n"
        "DEADTIME 15\n"
        "POWERDOWNFLAG /etc/killpower\n"
        "RBWARNTIME 43200\n"
        "NOCOMMWARNTIME 300\n"
        "FINALDELAY 5"
    )

    atomic_write(CONF_DIR / "nut.conf", set_mode)
    atomic_write(CONF_DIR / "ups.conf", ups_conf)
    atomic_write(CONF_DIR / "upsd.conf", upsd_conf)
    atomic_write(CONF_DIR / "upsd.users", users_conf)
    atomic_write(CONF_DIR / "upsmon.conf", upsmon_conf)
    secure_permissions()
    apply_output = apply_configuration()

    credentials: dict[str, Any] = {
        "primary": {
            "username": primary_user,
            "password": primary_password if generated_primary else "",
            "generated": generated_primary,
        }
    }
    if mode == "netserver":
        credentials["client"] = {
            "username": client_user,
            "password": client_password if generated_client else "",
            "generated": generated_client,
        }
    return {
        "message": "NUT server configuration saved.",
        "backup": backup,
        "target": f"{ups_name}@localhost",
        "listen": f"{listen_ip}:{NUT_PORT}",
        "credentials": credentials,
        "apply_output": apply_output,
    }


def op_client_setup(data: dict[str, Any]) -> dict[str, Any]:
    require_root()
    host = validate_host(data.get("server_host"), "Server address")
    ups_name = validate_identifier(data.get("ups_name"), "UPS name")
    username = validate_identifier(data.get("username"), "Username")
    password, _ = validate_password(data.get("password"))
    role = str(data.get("role", "secondary"))
    if role not in {"primary", "secondary"}:
        raise AppError("Client role must be primary or secondary.")

    backup = backup_configs()
    nut_conf = (
        f"# Managed by {APP_NAME} {APP_VERSION}\n"
        "# Valid modes: none, standalone, netserver, netclient\n"
        "MODE=netclient"
    )
    upsmon_conf = (
        f"# Managed by {APP_NAME} {APP_VERSION}\n"
        f"MONITOR {ups_name}@{host} 1 {username} {password} {role}\n"
        "MINSUPPLIES 1\n"
        'SHUTDOWNCMD "/sbin/shutdown -h +0"\n'
        "POLLFREQ 5\n"
        "POLLFREQALERT 5\n"
        "HOSTSYNC 15\n"
        "DEADTIME 15\n"
        "POWERDOWNFLAG /etc/killpower\n"
        "RBWARNTIME 43200\n"
        "NOCOMMWARNTIME 300\n"
        "FINALDELAY 5"
    )
    atomic_write(CONF_DIR / "nut.conf", nut_conf)
    atomic_write(CONF_DIR / "upsmon.conf", upsmon_conf)
    secure_permissions()
    apply_output = apply_configuration()
    return {
        "message": "NUT network client configuration saved.",
        "backup": backup,
        "target": f"{ups_name}@{host}",
        "role": role,
        "apply_output": apply_output,
    }


def op_config_get(data: dict[str, Any]) -> dict[str, Any]:
    name = str(data.get("name", ""))
    if name not in ALLOWED_CONFIGS:
        raise AppError("Unsupported configuration file.")
    path = CONF_DIR / name
    content = path.read_text(encoding="utf-8", errors="replace") if path.exists() else ""
    return {"name": name, "path": str(path), "content": content}


def op_config_save(data: dict[str, Any]) -> dict[str, Any]:
    require_root()
    name = str(data.get("name", ""))
    if name not in ALLOWED_CONFIGS:
        raise AppError("Unsupported configuration file.")
    content = data.get("content", "")
    if not isinstance(content, str):
        raise AppError("Configuration content must be text.")
    if len(content.encode("utf-8")) > 2_000_000:
        raise AppError("Configuration file is too large.")
    backup = backup_configs()
    atomic_write(CONF_DIR / name, content)
    secure_permissions()
    apply_output = "Not applied."
    if bool(data.get("apply", True)):
        apply_output = apply_configuration()
    return {
        "message": f"{name} saved.",
        "backup": backup,
        "apply_output": apply_output,
    }


def replace_user_section(content: str, username: str, section: str) -> str:
    lines = content.splitlines()
    output: list[str] = []
    skipping = False
    for line in lines:
        match = re.match(r"^\s*\[([^]]+)\]\s*$", line)
        if match:
            skipping = match.group(1).strip() == username
        if not skipping:
            output.append(line)
    cleaned = "\n".join(output).rstrip()
    return f"{cleaned}\n\n{section}\n" if cleaned else f"{section}\n"


def op_user_upsert(data: dict[str, Any]) -> dict[str, Any]:
    require_root()
    username = validate_identifier(data.get("username"), "Username")
    password, generated = validate_password(data.get("password"), allow_generate=True)
    profile = str(data.get("profile", "secondary"))
    if profile == "secondary":
        section = f"[{username}]\n    password = {password}\n    upsmon secondary"
    elif profile == "primary":
        section = f"[{username}]\n    password = {password}\n    upsmon primary"
    elif profile == "admin":
        section = (
            f"[{username}]\n"
            f"    password = {password}\n"
            "    actions = SET\n"
            "    actions = FSD\n"
            "    instcmds = ALL"
        )
    elif profile == "readonly":
        section = f"[{username}]\n    password = {password}"
    else:
        raise AppError("Unknown user permission profile.")

    path = CONF_DIR / "upsd.users"
    existing = path.read_text(encoding="utf-8", errors="replace") if path.exists() else ""
    backup = backup_configs()
    atomic_write(path, replace_user_section(existing, username, section))
    secure_permissions()
    restart = run(["systemctl", "restart", "nut-server.service"], timeout=45) if not DRY_RUN else None
    return {
        "message": f"User [{username}] was added or replaced.",
        "backup": backup,
        "generated_password": password if generated else "",
        "restart_output": restart.stdout.strip() if restart else "Dry-run mode.",
    }


def op_usb_scan(_: dict[str, Any]) -> dict[str, Any]:
    require_root()
    result = run(["nut-scanner", "-U"], timeout=45)
    return {"output": result.stdout, "exit_status": result.returncode}


def op_ups_status(data: dict[str, Any]) -> dict[str, Any]:
    target = str(data.get("target", default_ups_target())).strip()
    if not target or any(char.isspace() for char in target):
        raise AppError("UPS target is invalid.")
    result = run(["upsc", target], timeout=20)
    return {"output": result.stdout, "exit_status": result.returncode, "target": target}


def op_list_ups(data: dict[str, Any]) -> dict[str, Any]:
    host = validate_host(data.get("host", "localhost"))
    result = run(["upsc", "-L", host], timeout=20)
    return {"output": result.stdout, "exit_status": result.returncode, "host": host}


def services_for_scope(scope: str) -> list[str]:
    mapping = {
        "all": ["nut-server.service", "nut-monitor.service", "nut-driver.target"],
        "server": ["nut-server.service"],
        "monitor": ["nut-monitor.service"],
        "drivers": ["nut-driver.target"],
    }
    if scope not in mapping:
        raise AppError("Unknown service group.")
    return mapping[scope]


def op_service(data: dict[str, Any]) -> dict[str, Any]:
    require_root()
    scope = str(data.get("scope", "all"))
    action = str(data.get("action", "status"))
    if action not in {"status", "restart", "start", "stop", "enable", "disable"}:
        raise AppError("Unknown service action.")
    chunks: list[str] = []
    exit_status = 0
    for service in services_for_scope(scope):
        chunks.append(f"===== {service} =====")
        command = ["systemctl"]
        if action == "status":
            command += ["status", service, "--no-pager", "-l"]
        else:
            command += [action, service]
        result = run(command, timeout=60)
        exit_status = max(exit_status, result.returncode)
        chunks.append(result.stdout.rstrip())
        chunks.append(f"Exit status: {result.returncode}\n")
    if scope == "drivers":
        result = run(["systemctl", "list-units", "nut-driver@*.service", "--all", "--no-pager"], timeout=20)
        chunks.append("===== Driver instances =====")
        chunks.append(result.stdout.rstrip())
    return {"output": "\n".join(chunks), "exit_status": exit_status}


def op_driver(data: dict[str, Any]) -> dict[str, Any]:
    require_root()
    action = str(data.get("action", "status"))
    chunks: list[str] = []
    exit_status = 0
    if action == "list":
        chunks.append("Configured UPS sections:")
        chunks.extend(f"[{name}]" for name in configured_ups_names())
        result = run(["systemctl", "list-units", "nut-driver@*.service", "--all", "--no-pager"], timeout=20)
        chunks.append("\nSystemd driver instances:")
        chunks.append(result.stdout.rstrip())
        exit_status = result.returncode
    elif action == "resync":
        if not command_exists("upsdrvsvcctl"):
            raise AppError("upsdrvsvcctl is unavailable in the installed NUT package.")
        result = run(["upsdrvsvcctl", "resync"], timeout=60)
        chunks.append(result.stdout.rstrip())
        exit_status = result.returncode
    elif action == "restart":
        if command_exists("upsdrvsvcctl"):
            stop = run(["upsdrvsvcctl", "stop"], timeout=60)
            start = run(["upsdrvsvcctl", "start"], timeout=60)
            chunks.extend([stop.stdout.rstrip(), start.stdout.rstrip()])
            exit_status = max(stop.returncode, start.returncode)
        else:
            result = run(["systemctl", "restart", "nut-driver.target"], timeout=60)
            chunks.append(result.stdout.rstrip())
            exit_status = result.returncode
    elif action == "status":
        if command_exists("upsdrvsvcctl"):
            status = run(["upsdrvsvcctl", "status"], timeout=30)
            listing = run(["upsdrvsvcctl", "list"], timeout=30)
            chunks.extend([status.stdout.rstrip(), "\nService mapping:", listing.stdout.rstrip()])
            exit_status = max(status.returncode, listing.returncode)
        else:
            result = run(["systemctl", "status", "nut-driver.target", "--no-pager", "-l"], timeout=30)
            chunks.append(result.stdout.rstrip())
            exit_status = result.returncode
        units = run(["systemctl", "list-units", "nut-driver@*.service", "--all", "--no-pager"], timeout=20)
        chunks.extend(["\nDriver instances:", units.stdout.rstrip()])
    else:
        raise AppError("Unknown driver action.")
    return {"output": "\n".join(part for part in chunks if part), "exit_status": exit_status}


def op_logs(data: dict[str, Any]) -> dict[str, Any]:
    try:
        lines = int(data.get("lines", 200))
    except (TypeError, ValueError) as exc:
        raise AppError("Log line count must be a number.") from exc
    if not 1 <= lines <= 5000:
        raise AppError("Log line count must be between 1 and 5000.")
    result = run(
        [
            "journalctl",
            "-u",
            "nut-server.service",
            "-u",
            "nut-monitor.service",
            "-u",
            "nut-driver.target",
            "-u",
            "nut-driver-enumerator.service",
            "-n",
            str(lines),
            "--no-pager",
            "-o",
            "short-iso",
        ],
        timeout=30,
    )
    return {"output": result.stdout, "exit_status": result.returncode}


def op_diagnostics(_: dict[str, Any]) -> dict[str, Any]:
    chunks: list[str] = [
        f"{APP_NAME} {APP_VERSION} diagnostics",
        f"Generated: {dt.datetime.now().astimezone().isoformat()}",
        f"Architecture: {os.uname().machine}",
        f"NUT mode: {parse_mode()}",
        f"Default target: {default_ups_target()}",
        "",
        "--- Installed commands ---",
    ]
    for command in ["upsc", "upsd", "upsmon", "upsdrvctl", "upsdrvsvcctl", "nut-scanner", "nutconf"]:
        chunks.append(f"{command:16} {shutil.which(command) or 'MISSING'}")

    commands: list[tuple[str, list[str], int]] = [
        ("NUT version", ["upsc", "-V"], 10),
        ("Configuration permissions", ["ls", "-ld", str(CONF_DIR)], 10),
        ("Configuration files", ["ls", "-l", str(CONF_DIR)], 10),
        ("Driver instances", ["systemctl", "list-units", "nut-driver@*.service", "--all", "--no-pager"], 20),
        ("Listening sockets", ["ss", "-ltnp"], 15),
        ("USB devices", ["lsusb"], 15),
        ("UPS list on localhost", ["upsc", "-L", "localhost"], 15),
        (f"Status for {default_ups_target()}", ["upsc", default_ups_target()], 15),
    ]
    for title, command, timeout in commands:
        chunks.extend(["", f"--- {title} ---"])
        try:
            result = run(command, timeout=timeout)
            output = result.stdout
            if title == "Listening sockets":
                matching = [line for line in output.splitlines() if f":{NUT_PORT}" in line]
                output = "\n".join(matching) or "No NUT listener detected."
            chunks.append(output.rstrip())
        except AppError as exc:
            chunks.append(str(exc))

    chunks.extend(["", "--- Service states ---"])
    for service in ["nut-server.service", "nut-monitor.service", "nut-driver.target", "nut-driver-enumerator.service"]:
        state = service_state(service)
        chunks.append(f"{service:34} active={state['active']:12} enabled={state['enabled']}")

    chunks.extend(["", "--- Recent warnings/errors ---"])
    result = run(
        [
            "journalctl",
            "-u",
            "nut-server.service",
            "-u",
            "nut-monitor.service",
            "-u",
            "nut-driver.target",
            "-p",
            "warning",
            "-n",
            "80",
            "--no-pager",
        ],
        timeout=30,
    )
    chunks.append(result.stdout.rstrip())
    return {"output": "\n".join(chunks)}


def op_backups_list(_: dict[str, Any]) -> dict[str, Any]:
    ensure_dirs()
    items: list[dict[str, Any]] = []
    for path in sorted((p for p in BACKUP_ROOT.iterdir() if p.is_dir()), reverse=True):
        size = 0
        files = 0
        for child in path.rglob("*"):
            if child.is_file():
                files += 1
                size += child.stat().st_size
        items.append(
            {
                "name": path.name,
                "files": files,
                "size": size,
                "modified": dt.datetime.fromtimestamp(path.stat().st_mtime).astimezone().isoformat(),
            }
        )
    return {"backups": items}


def op_backup_create(_: dict[str, Any]) -> dict[str, Any]:
    require_root()
    return {"message": "Configuration backup created.", "backup": backup_configs()}


def op_backup_restore(data: dict[str, Any]) -> dict[str, Any]:
    require_root()
    name = str(data.get("name", "")).strip()
    if not re.fullmatch(r"[0-9A-Za-z._-]+", name):
        raise AppError("Invalid backup name.")
    source = (BACKUP_ROOT / name).resolve()
    root = BACKUP_ROOT.resolve()
    if source.parent != root or not source.is_dir():
        raise AppError("Backup was not found.")
    current_backup = backup_configs()
    ensure_dirs()
    for item in CONF_DIR.iterdir():
        if item.is_dir() and not item.is_symlink():
            shutil.rmtree(item)
        else:
            item.unlink()
    for item in source.iterdir():
        destination = CONF_DIR / item.name
        if item.is_dir():
            shutil.copytree(item, destination, symlinks=True)
        else:
            shutil.copy2(item, destination, follow_symlinks=False)
    secure_permissions()
    apply_output = apply_configuration()
    return {
        "message": f"Backup {name} restored.",
        "previous_configuration_backup": current_backup,
        "apply_output": apply_output,
    }


def op_apply(_: dict[str, Any]) -> dict[str, Any]:
    require_root()
    return {"message": "NUT configuration applied.", "output": apply_configuration()}


OPERATIONS = {
    "summary": op_summary,
    "server-setup": op_server_setup,
    "client-setup": op_client_setup,
    "config-get": op_config_get,
    "config-save": op_config_save,
    "user-upsert": op_user_upsert,
    "usb-scan": op_usb_scan,
    "ups-status": op_ups_status,
    "list-ups": op_list_ups,
    "service": op_service,
    "driver": op_driver,
    "logs": op_logs,
    "diagnostics": op_diagnostics,
    "backups-list": op_backups_list,
    "backup-create": op_backup_create,
    "backup-restore": op_backup_restore,
    "apply": op_apply,
}


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", choices=sorted(OPERATIONS))
    args = parser.parse_args()
    try:
        data = read_payload()
        result = OPERATIONS[args.operation](data)
        emit(result)
    except AppError as exc:
        fail(str(exc))
    except PermissionError as exc:
        fail("Permission denied while updating NUT configuration.", details=str(exc))
    except Exception as exc:  # Defensive boundary for the browser UI.
        fail("Unexpected backend error.", details=f"{type(exc).__name__}: {exc}")


if __name__ == "__main__":
    main()
